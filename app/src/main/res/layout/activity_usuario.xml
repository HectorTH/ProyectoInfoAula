<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F9F5"
    tools:context=".Usuario">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tbUsuario"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#CCEBCE"
        android:minHeight="?attr/actionBarSize"
        app:title="Mi Perfil Institucional"
        app:titleTextColor="#1B3F21"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbUsuario">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvPerfilNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre: Cargando..."
                android:textColor="#1B3F21"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvPerfilMatricula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matrícula: Cargando..."
                android:textColor="#555555"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvPerfilCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Correo: Cargando..."
                android:textColor="#555555"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvPerfilCarrera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carrera: Cargando..."
                android:textColor="#555555"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvPerfilSemestre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Semestre: Cargando..."
                android:textColor="#555555"
                android:textSize="16sp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>