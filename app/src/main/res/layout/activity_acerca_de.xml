<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F9F5"
    tools:context=".AcercaDe">

    <!-- BARRA SUPERIOR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tbAcercaDe"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#CCEBCE"
        android:minHeight="?attr/actionBarSize"
        app:title="Acerca de"
        app:titleTextColor="#1B3F21"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- LOGOTIPO DE LA APLICACIÓN -->
    <ImageView
        android:id="@+id/ivLogoAcerca"
        android:layout_width="240dp"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        android:contentDescription="Logotipo InfoAula"
        android:scaleType="centerInside"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbAcercaDe" />

    <!-- FICHA TÉCNICA DETALLADA (FIGMA) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivLogoAcerca">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACERCA DE:"
            android:textColor="#1B3F21"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre de la aplicación: INFOAULA"
            android:textColor="#333333"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Creado por: UkyoMax SA de CV"
            android:textColor="#333333"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Versión de la aplicación: 1.0.5"
            android:textColor="#333333"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Año de lanzamiento: 2026"
            android:textColor="#333333"
            android:textSize="15sp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>