<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F9F5"
    tools:context=".Materias">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tbMaterias"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#CCEBCE"
        android:minHeight="?attr/actionBarSize"
        app:title="Estatus de Materias"
        app:titleTextColor="#1B3F21"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMaterias"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbMaterias"
        tools:listitem="@layout/item_materia" />

</androidx.constraintlayout.widget.ConstraintLayout>