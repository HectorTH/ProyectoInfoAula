<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/viewIndicadorColor"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@android:drawable/presence_online"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemNombreProfe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Profesor"
                android:textStyle="bold"
                android:textColor="#1B3F21"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvItemUbicacionProfe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Ubicación: Sin registrar"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvItemEstatusTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disponible"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>